# ---- Required (Supabase: Project Settings -> API) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" key or new "publishable" key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key or new "secret" key. SERVER ONLY. Used for account deletion + Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (optional; the site works without them) ----
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the ¥200/month recurring price
STRIPE_PRICE_ID=
